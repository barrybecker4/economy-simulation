{
  "name": "economy-simulation",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b && pnpm --filter @economy-simulation/core run typecheck && pnpm --filter @economy-simulation/app run typecheck",
    "test": "vitest run",
    "assumptions:check": "vitest run packages/core/src/config/assumptions.test.ts",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test && pnpm run assumptions:check",
    "sim": "tsc -b --pretty false && node packages/cli/dist/main.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.5.2",
    "eslint": "^10.12.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.4",
    "wrangler": "^3.90.0"
  }
}
